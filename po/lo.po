#: libcaja-private/caja-undostack-manager.c:1703
#, c-format
msgid "Redo change group of %d item"
msgid_plural "Redo change group of %d items"
msgstr[0] "ເຮັດຄືນການປ່ຽນກຸ່ມຂອງ %d ລາຍການ"

#: libcaja-private/caja-undostack-manager.c:1708
#, c-format
msgid "Redo change owner of %d item"
msgid_plural "Redo change owner of %d items"
msgstr[0] "ເຮັດຄືນການປ່ຽນເຈົ້າຂອງຂອງ %d ລາຍການ"

#: libcaja-private/org.mate.caja.gschema.xml:77
msgid "Where to position newly open tabs in browser windows."
msgstr "ຕຳແໜ່ງທີ່ຈະວາງແທັບໃໝ່ທີ່ເປີດໃນໜ້າຕ່າງບຣາວເຊີ."

#: libcaja-private/org.mate.caja.gschema.xml:78
msgid ""
"If set to \"after-current-tab\", then new tabs are inserted after the "
"current tab. If set to \"end\", then new tabs are appended to the end of the "
"tab list."
msgstr ""
"ຖ້າຕັ້ງເປັນ \"after-current-tab\", ແທັບໃໝ່ຈະຖືກແຊກໃສ່ຖັດຈາກແທັບປັດຈຸບັນ. ຖ້າຕັ້ງເປັນ \"end\", "
"ແທັບໃໝ່ຈະຖືກເພີ່ມໃສ່ທ້າຍສຸດຂອງລາຍການແທັບ."

#: libcaja-private/org.mate.caja.gschema.xml:82
msgid "Switch tabs with [ctrl] + [tab]"
msgstr "ສະຫຼັບແທັບດ້ວຍ [ctrl] + [tab]"

#: libcaja-private/org.mate.caja.gschema.xml:83
msgid ""
"If true, it enables the ability to switch tabs using [ctrl + tab] and [ctrl "
"+ shift + tab]."
msgstr ""
"ຖ້າເລືອກ, ຈະສາມາດສະຫຼັບແທັບໂດຍໃຊ້ [ctrl + tab] ແລະ [ctrl + shift + tab] ໄດ້."

#: libcaja-private/org.mate.caja.gschema.xml:87
msgid "Caja will exit when last window destroyed."
msgstr "Caja ຈະປິດການທຳງານເມື່ອໜ້າຕ່າງສຸດທ້າຍຖືກປິດ."

#: libcaja-private/org.mate.caja.gschema.xml:88
msgid ""
"If set to true, then Caja will exit when all windows are destroyed. This is "
"the default setting. If set to false, it can be started without any window, "
"so Caja can serve as a daemon to monitor media automount, or similar tasks."
msgstr ""
"ຖ້າຕັ້ງເປັນ true, Caja ຈະປິດເມື່ອທຸກໜ້າຕ່າງຖືກປິດ. ນີ້ແມ່ນຄ່າເລີ່ມຕົ້ນ. ຖ້າຕັ້ງເປັນ false, ມັນສາມາດເຮັດ"
"ວຽກໄດ້ໂດຍບໍ່ມີໜ້າຕ່າງ ເພື່ອໃຫ້ Caja ເຮັດໜ້າທີ່ເປັນ daemon ໃນການກວດສອບການຕິດຕັ້ງສື່ບັນທຶກຂໍ້ມູນອັດຕະໂນມັ"
"ດ ຫຼື ວຽກອື່ນໆທີ່ຄ້າຍຄືກັນ."

#: libcaja-private/org.mate.caja.gschema.xml:92
msgid "Enables the classic Caja behavior, where all windows are browsers"
msgstr "ເປີດໃຊ້ຮູບແບບການເຮັດວຽກແບບຄລາສສິກຂອງ Caja ທີ່ທຸກໜ້າຕ່າງແມ່ນບຣາວເຊີ"

#: libcaja-private/org.mate.caja.gschema.xml:93
msgid ""
"If set to true, then all Caja windows will be browser windows. This is how "
"Nautilus used to behave before version 2.6, and some people prefer this "
"behavior."
msgstr ""
"ຖ້າຕັ້ງເປັນ true, ທຸກໜ້າຕ່າງຂອງ Caja ຈະເປັນໜ້າຕ່າງບຣາວເຊີ. ນີ້ແມ່ນຮູບແບບທີ່ Nautilus ເຄີຍໃຊ້ກ່ອນເ"
"ວີຊັນ 2.6 ແລະ ບາງຄົນມັກຮູບແບບນີ້."

#: libcaja-private/org.mate.caja.gschema.xml:97
msgid "Always use the location entry, instead of the pathbar"
msgstr "ໃຊ້ຊ່ອງປ້ອນຕຳແໜ່ງສະເໝີ ແທນທີ່ຈະເປັນແຖບເສັ້ນທາງ (pathbar)"

#: libcaja-private/org.mate.caja.gschema.xml:98
msgid ""
"If set to true, then Caja browser windows will always use a textual input "
"entry for the location toolbar, instead of the pathbar."
msgstr ""
"ຖ້າຕັ້ງເປັນ true, ໜ້າຕ່າງບຣາວເຊີຂອງ Caja ຈະໃຊ້ຊ່ອງປ້ອນຂໍ້ຄວາມສຳລັບແຖບເຄື່ອງມືຕຳແໜ່ງສະເໝີ ແທນທີ່ຈະ"
"ເປັນປຸ່ມເສັ້ນທາງ."

#: libcaja-private/org.mate.caja.gschema.xml:102
msgid "Whether to ask for confirmation when deleting files, or emptying Trash"
msgstr "ກຳນົດວ່າຈະໃຫ້ຖາມເພື່ອຢືນຢັນບໍ່ ເມື່ອມີການລຶບໄຟລ໌ ຫຼື ລ້າງຖັງຂີ້ເຫຍື້ອ"

#: libcaja-private/org.mate.caja.gschema.xml:103
msgid ""
"If set to true, then Caja will ask for confirmation when you attempt to "
"delete files, or empty the Trash."
msgstr ""
"ຖ້າຕັ້ງເປັນ true, Caja ຈະຖາມເພື່ອຢືນຢັນເມື່ອເຈົ້າພະຍາຍາມລຶບໄຟລ໌ ຫຼື ລ້າງຖັງຂີ້ເຫຍື້ອ."

#: libcaja-private/org.mate.caja.gschema.xml:107
msgid "Whether to ask for confirmation when moving files to the Trash"
msgstr "ກຳນົດວ່າຈະໃຫ້ຖາມເພື່ອຢືນຢັນບໍ່ ເມື່ອມີການຍ້າຍໄຟລ໌ໄປຖັງຂີ້ເຫຍື້ອ"

#: libcaja-private/org.mate.caja.gschema.xml:108
msgid ""
"If set to true, then Caja will ask for confirmation when you attempt to move "
"files to the Trash."
msgstr ""
"ຖ້າຕັ້ງເປັນ true, Caja ຈະຖາມເພື່ອຢືນຢັນເມື່ອເຈົ້າພະຍາຍາມຍ້າຍໄຟລ໌ໄປຖັງຂີ້ເຫຍື້ອ."

#: libcaja-private/org.mate.caja.gschema.xml:112
msgid "Whether to enable immediate deletion"
msgstr "ກຳນົດວ່າຈະໃຫ້ເປີດໃຊ້ການລຶບຖິ້ມທັນທີບໍ່"

#: libcaja-private/org.mate.caja.gschema.xml:113
msgid ""
"If set to true, then Caja will have a feature allowing you to delete a file "
"immediately and in-place, instead of moving it to the trash. This feature "
"can be dangerous, so use caution."
msgstr ""
"ຖ້າຕັ້ງເປັນ true, Caja ຈະມີຟີເຈີທີ່ຊ່ວຍໃຫ້ເຈົ້າລຶບໄຟລ໌ໄດ້ທັນທີ ແທນທີ່ຈະຍ້າຍໄປຖັງຂີ້ເຫຍື້ອ. ຟີເຈີນີ້ອາດຈະອັນຕ"
"ະລາຍ, ຄວນໃຊ້ດ້ວຍຄວາມລະມັດລະວັງ."

#: libcaja-private/org.mate.caja.gschema.xml:118
msgid "When to show preview text in icons"
msgstr "ຈະໃຫ້ສະແດງຂໍ້ຄວາມຕົວຢ່າງໃນໄອຄອນຕອນໃດ"

#: libcaja-private/org.mate.caja.gschema.xml:119
msgid ""
"Speed tradeoff for when to show a preview of text file contents in the "
"file's icon. If set to \"always\" then always show previews, even if the "
"folder is on a remote server. If set to \"local-only\" then only show "
"previews for local file systems. If set to \"never\" then never bother to "
"read preview data."
msgstr ""
"ການເລືອກລະຫວ່າງຄວາມໄວ ກັບການສະແດງຕົວຢ່າງເນື້ອຫາໄຟລ໌ຂໍ້ຄວາມໃນໄອຄອນ. ຖ້າຕັ້ງເປັນ \"always\" ຈ"
"ະສະແດງຕົວຢ່າງສະເໝີ ແມ່ນແຕ່ໃນເຊີເວີທາງໄກ. ຖ້າຕັ້ງເປັນ \"local-only\" ຈະສະແດງສະເພາະໄຟລ໌ໃນເຄື່"
"ອງ. ຖ້າຕັ້ງເປັນ \"never\" ຈະບໍ່ມີການອ່ານຂໍ້ມູນຕົວຢ່າງເລີຍ."

#: libcaja-private/org.mate.caja.gschema.xml:124
msgid "When to show number of items in a folder"
msgstr "ຈະໃຫ້ສະແດງຈຳນວນລາຍການໃນໂຟນເດີຕອນໃດ"

#: libcaja-private/org.mate.caja.gschema.xml:125
msgid ""
"Speed tradeoff for when to show the number of items in a folder. If set to "
"\"always\" then always show item counts, even if the folder is on a remote "
"server. If set to \"local-only\" then only show counts for local file "
"systems. If set to \"never\" then never bother to compute item counts."
msgstr ""
"ການເລືອກລະຫວ່າງຄວາມໄວ ກັບການສະແດງຈຳນວນລາຍການໃນໂຟນເດີ. ຖ້າຕັ້ງເປັນ \"always\" ຈະສະແດງຈ"
"ຳນວນສະເໝີ. ຖ້າຕັ້ງເປັນ \"local-only\" ຈະສະແດງສະເພາະໃນເຄື່ອງ. ຖ້າຕັ້ງເປັນ \"never\" ຈະບໍ່ມີກ"
"ານຄິດໄລ່ຈຳນວນເລີຍ."

#: libcaja-private/org.mate.caja.gschema.xml:129
msgid "Type of click used to launch/open files"
msgstr "ປະເພດຂອງການຄລິກທີ່ໃຊ້ເພື່ອເປີດໄຟລ໌"

#: libcaja-private/org.mate.caja.gschema.xml:130
msgid ""
"Possible values are \"single\" to launch files on a single click, or "
"\"double\" to launch them on a double click."
msgstr ""
"ຄ່າທີ່ເປັນໄປໄດ້ຄື \"single\" ເພື່ອເປີດໄຟລ໌ດ້ວຍການຄລິກບາດດຽວ, ຫຼື \"double\" ເພື່ອເປີດດ້ວຍການດັບເ"
"ບິນຄລິກ."

#: libcaja-private/org.mate.caja.gschema.xml:134
msgid "What to do with executable text files when activated"
msgstr "ຈະໃຫ້ເຮັດແນວໃດກັບໄຟລ໌ຂໍ້ຄວາມທີ່ເປີດໃຊ້ງານໄດ້ ເມື່ອມີການຄລິກ"

#: libcaja-private/org.mate.caja.gschema.xml:135
msgid ""
"What to do with executable text files when they are activated (single or "
"double clicked). Possible values are \"launch\" to launch them as programs, "
"\"ask\" to ask what to do via a dialog, and \"display\" to display them as "
"text files."
msgstr ""
"ຈະໃຫ້ເຮັດແນວໃດກັບໄຟລ໌ຂໍ້ຄວາມທີ່ເປີດໃຊ້ງານໄດ້ (ເມື່ອຄລິກ ຫຼື ດັບເບິນຄລິກ). ຄ່າທີ່ເປັນໄປໄດ້ຄື "
"\"launch\" ເພື່ອເປີດເປັນໂປຣແກຣມ, \"ask\" ເພື່ອໃຫ້ຖາມກ່ອນ, ແລະ \"display\" ເພື່ອສະແດງເປັນ"
"ໄຟລ໌ຂໍ້ຄວາມ."

#: libcaja-private/org.mate.caja.gschema.xml:139
msgid "Show the package installer for unknown MIME types"
msgstr "ສະແດງຕົວຕິດຕັ້ງແພັກເກດສຳລັບປະເພດ MIME ທີ່ບໍ່ຮູ້ຈັກ"

#: libcaja-private/org.mate.caja.gschema.xml:140
msgid ""
"Whether to show the user a package installer dialog in case an unknown MIME "
"type is opened, in order to search for an application to handle it."
msgstr ""
"ກຳນົດວ່າຈະໃຫ້ສະແດງໄດອະລັອກຕົວຕິດຕັ້ງແພັກເກດບໍ່ ໃນກໍລະນີທີ່ເປີດປະເພດ MIME ທີ່ບໍ່ຮູ້ຈັກ ເພື່ອຄົ້ນຫາແອັບພລິເຄ"
"ຊັນມາຈັດການ."

#: libcaja-private/org.mate.caja.gschema.xml:144
msgid "Use extra mouse button events in Caja' browser window"
msgstr "ໃຊ້ປຸ່ມເມົາສ໌ເສີມໃນໜ້າຕ່າງບຣາວເຊີຂອງ Caja"

#: libcaja-private/org.mate.caja.gschema.xml:145
msgid ""
"For users with mice that have \"Forward\" and \"Back\" buttons, this key "
"will determine if any action is taken inside of Caja when either is pressed."
msgstr ""
"ສຳລັບຜູ້ໃຊ້ທີ່ມີເມົາສ໌ທີ່ມີປຸ່ມ \"Forward\" (ຖັດໄປ) ແລະ \"Back\" (ກັບຄືນ), ຄ່ານີ້ຈະກຳນົດວ່າຈະໃຫ້ມີການ"
"ກະທຳໃດໆໃນ Caja ບໍ່ເມື່ອມີການກົດປຸ່ມເຫຼົ່ານັ້ນ."

#: libcaja-private/org.mate.caja.gschema.xml:149
msgid "Mouse button to activate the \"Forward\" command in browser window"
msgstr "ປຸ່ມເມົາສ໌ທີ່ຈະເປີດໃຊ້ຄຳສັ່ງ \"Forward\" ໃນໜ້າຕ່າງບຣາວເຊີ"

#: libcaja-private/org.mate.caja.gschema.xml:150
msgid ""
"For users with mice that have buttons for \"Forward\" and \"Back\", this key "
"will set which button activates the \"Forward\" command in a browser window. "
"Possible values range between 6 and 14."
msgstr ""
"ສຳລັບຜູ້ໃຊ້ທີ່ມີເມົາສ໌ທີ່ມີປຸ່ມ \"Forward\" ແລະ \"Back\", ຄ່ານີ້ຈະຕັ້ງວ່າປຸ່ມໃດຈະເປີດໃຊ້ຄຳສັ່ງ "
"\"Forward\". ຄ່າທີ່ເປັນໄປໄດ້ແມ່ນລະຫວ່າງ 6 ຫາ 14."

#: libcaja-private/org.mate.caja.gschema.xml:154
msgid "Mouse button to activate the \"Back\" command in browser window"
msgstr "ປຸ່ມເມົາສ໌ທີ່ຈະເປີດໃຊ້ຄຳສັ່ງ \"Back\" ໃນໜ້າຕ່າງບຣາວເຊີ"

#: libcaja-private/org.mate.caja.gschema.xml:155
msgid ""
"For users with mice that have buttons for \"Forward\" and \"Back\", this key "
"will set which button activates the \"Back\" command in a browser window. "
"Possible values range between 6 and 14."
msgstr ""
"ສຳລັບຜູ້ໃຊ້ທີ່ມີເມົາສ໌ທີ່ມີປຸ່ມ \"Forward\" ແລະ \"Back\", ຄ່ານີ້ຈະຕັ້ງວ່າປຸ່ມໃດຈະເປີດໃຊ້ຄຳສັ່ງ "
"\"Back\". ຄ່າທີ່ເປັນໄປໄດ້ແມ່ນລະຫວ່າງ 6 ຫາ 14."

#: libcaja-private/org.mate.caja.gschema.xml:160
msgid "When to show thumbnails of image files"
msgstr "ຈະໃຫ້ສະແດງຮູບຕົວຢ່າງຂອງໄຟລ໌ຮູບພາບຕອນໃດ"

#: libcaja-private/org.mate.caja.gschema.xml:161
msgid ""
"Speed tradeoff for when to show an image file as a thumbnail. If set to "
"\"always\" then always thumbnail, even if the folder is on a remote server. "
"If set to \"local-only\" then only show thumbnails for local file systems. "
"If set to \"never\" then never bother to thumbnail images, just use a "
"generic icon."
msgstr ""
"ການເລືອກລະຫວ່າງຄວາມໄວ ກັບການສະແດງຮູບຕົວຢ່າງ. ຖ້າຕັ້ງເປັນ \"always\" ຈະສະແດງຮູບຕົວຢ່າງສະເ"
"ໝີ. ຖ້າຕັ້ງເປັນ \"local-only\" ຈະສະແດງສະເພາະໄຟລ໌ໃນເຄື່ອງ. ຖ້າຕັ້ງເປັນ \"never\" ຈະໃຊ້ແຕ່ໄອຄ"
"ອນທົ່ວໄປ."

#: libcaja-private/org.mate.caja.gschema.xml:165
msgid "Maximum image size for thumbnailing"
msgstr "ຂະໜາດຮູບພາບສູງສຸດທີ່ຈະສ້າງຮູບຕົວຢ່າງ"

#: libcaja-private/org.mate.caja.gschema.xml:166
msgid ""
"Images over this size (in bytes) won't be thumbnailed. The purpose of this "
"setting is to avoid thumbnailing large images that may take a long time to "
"load or use lots of memory."
msgstr ""
"ຮູບທີ່ມີຂະໜາດໃຫຍ່ກວ່າຄ່ານີ້ (ເປັນໄບຕ໌) ຈະບໍ່ຖືກສ້າງຮູບຕົວຢ່າງ ເພື່ອຫຼີກເວັ້ນການໃຊ້ເວລາໂຫຼດດົນ ຫຼື ໃຊ້ໜ່ວຍຄວາ"
"ມຈຳຫຼາຍເກີນໄປ."

#: libcaja-private/org.mate.caja.gschema.xml:171
msgid "Whether to preview sounds when mousing over an icon"
msgstr "ຈະໃຫ້ຫຼິ້ນສຽງຕົວຢ່າງບໍ່ ເມື່ອເອົາເມົາສ໌ໄປວາງເທິງໄອຄອນ"

#: libcaja-private/org.mate.caja.gschema.xml:172
msgid ""
"Speed tradeoff for when to preview a sound file when mousing over a files "
"icon. If set to \"always\" then always plays the sound, even if the file is "
"on a remote server. If set to \"local-only\" then only plays previews on "
"local file systems. If set to \"never\" then it never previews sound."
msgstr ""
"ການເລືອກລະຫວ່າງຄວາມໄວ ກັບການຫຼິ້ນສຽງຕົວຢ່າງ. ຖ້າຕັ້ງເປັນ \"always\" ຈະຫຼິ້ນສະເໝີ. ຖ້າຕັ້ງເປັນ "
"\"local-only\" ຈະຫຼິ້ນສະເພາະໄຟລ໌ໃນເຄື່ອງ. ຖ້າຕັ້ງເປັນ \"never\" ຈະບໍ່ມີການຫຼິ້ນສຽງຕົວຢ່າງ."

#: libcaja-private/org.mate.caja.gschema.xml:176
msgid "Show advanced permissions in the file property dialog"
msgstr "ສະແດງສິດການເຂົ້າເຖິງຂັ້ນສູງໃນໄດອະລັອກຄຸນສົມບັດໄຟລ໌"

#: libcaja-private/org.mate.caja.gschema.xml:177
msgid ""
"If set to true, then Caja lets you edit and display file permissions in a "
"more unix-like way, accessing some more esoteric options."
msgstr ""
"ຖ້າຕັ້ງເປັນ true, Caja ຈະໃຫ້ເຈົ້າແກ້ໄຂ ແລະ ສະແດງສິດການເຂົ້າເຖິງໃນຮູບແບບທີ່ຄ້າຍຄື Unix ເຊິ່ງສາມາດ"
"ເຂົ້າເຖິງຕົວເລືອກທີ່ລະອຽດກວ່າໄດ້."

#: libcaja-private/org.mate.caja.gschema.xml:181
msgid "Show folders first in windows"
msgstr "ສະແດງໂຟນເດີກ່ອນໃນໜ້າຕ່າງ"

#: libcaja-private/org.mate.caja.gschema.xml:182
msgid ""
"If set to true, then Caja shows folders prior to showing files in the icon "
"and list views."
msgstr ""
"ຖ້າຕັ້ງເປັນ true, Caja ຈະສະແດງໂຟນເດີກ່ອນໄຟລ໌ໃນມຸມມອງໄອຄອນ ແລະ ມຸມມອງລາຍການ."

#: libcaja-private/org.mate.caja.gschema.xml:189
msgid "Default sort order"
msgstr "ລຳດັບການລຽງເລີ່ມຕົ້ນ"

#: libcaja-private/org.mate.caja.gschema.xml:190
msgid ""
"The default sort-order for items in all view modes. Possible values are: - "
"\"manually\": In icon- and compact-view modes, lets the user place and "
"organize items any way the user wants them to be organized, simply by "
"dragging each item to where the user desires. In list-view mode, this "
"setting is equivalent to \"name\" (see immediately below). - \"name\": Sort "
"items by their name; for example, a file named \"a.txt\" will be sorted "
"before a file named \"b.txt\". This is the default. - \"directory\": Sort "
"items by their full pathname. For example, a file named \"b.txt\" under the "
"directory \"/home/a\" will be sorted before a file named \"a.txt\" under the "
"directory \"/home/zzz\". Since Caja usually only displays files under one "
"directory at any particular time, this setting will usually be equivalent to "
"the \"name\" option (above), except in the Caja search tool, which can "
"traverse files under multiple subdirectories. - \"size\": Sort items by "
"their file size, or if the items are directories, by the number of items "
"they contain. - \"type\": Sort items by their human-readable type "
"description. Such type descriptions take the form of, for instance, \"plain "
"text document\" or \"SVG image\". The type of the file is not necessarily "
"related to the file's \"extension\" (see below). - \"mtime\": Sort items by "
"their respective times of last modification. - \"btime\": Sort items by the "
"date and time on which each file was created. Note that not all files have a "
"recorded creation time, so this setting may not always work as expected, "
"especially on removable media that are \"formatted\" with legacy filesystems "
"such as FAT. - \"atime\": Sort items by the date and time on which each file "
"was last accessed. Usually, \"accessed\" refers to the last time the file "
"was read by a user or a program. Note that, for performance reasons, some "
"filesystems do not update this timestamp every time the file is read, so "
"this field may be inaccurate. - \"emblems\": Sort items by the names of the "
"emblems (if any) associated with each item. - \"trash-time\": Sort items by "
"the date and time on which the file was moved to the Trash. This setting is "
"rarely useful, as it only applies to files currently in the Trash. - "
"\"size_on_disk\": Sort by the amount of actual disk space each item "
"consumes. This figure is usually slightly larger than the conventional size "
"of the file, since most filesystems pad files out to an even multiple of the "
"\"block size\", which on many filesystems is 4096 bytes or about 4 "
"kilobytes. A few files may use less space on the disk than the conventional "
"file size may indicate, due to a feature of some filesystems known as "
"\"holes\". This setting will not necessarily sort directories by the number "
"of files they contain, since the amount of disk space used by a directory is "
"not necessarily related to the number of files in a directory; other factors "
"that can contribute to a directory's actual size include the length of the "
"names of each file within the directory, and, interestingly, how many files "
"the directory used to contain. - \"extension\": Sort by each item's file "
"extension (if any). The file's extension is a part of the file's name, and "
"may not reflect the actual contents of the file, unlike the \"type\" setting "
"(above)."
msgstr ""
"ລຳດັບການລຽງເລີ່ມຕົ້ນສຳລັບລາຍການໃນທຸກມຸມມອງ. ຄ່າທີ່ເປັນໄປໄດ້ຄື: - \"manually\": ໃນມຸມມອງໄອຄອ"
"ນ ແລະ ມຸມມອງແບບກະທັດຮັດ, ໃຫ້ຜູ້ໃຊ້ຈັດວາງລາຍການໄດ້ຕາມໃຈໂດຍການລາກ. - \"name\": ລຽງຕາມຊື່ "
"(ເຊັ່ນ \"a.txt\" ມາກ່ອນ \"b.txt\"). ນີ້ແມ່ນຄ່າເລີ່ມຕົ້ນ. - \"directory\": ລຽງຕາມເສັ້ນທາງໄຟ"
"ລ໌ເຕັມ. - \"size\": ລຽງຕາມຂະໜາດໄຟລ໌ ຫຼື ຈຳນວນລາຍການໃນໂຟນເດີ. - \"type\": ລຽງຕາມປະເພ"
"ດໄຟລ໌ທີ່ຄົນອ່ານເຂົ້າໃຈໄດ້ (ເຊັ່ນ \"plain text document\"). - \"mtime\": ລຽງຕາມເວລາທີ່ມີການ"
"ແກ້ໄຂຄັ້ງລ່າສຸດ. - \"btime\": ລຽງຕາມເວລາທີ່ສ້າງໄຟລ໌. - \"atime\": ລຽງຕາມເວລາທີ່ມີການເຂົ້າເຖິ"
"ງຄັ້ງລ່າສຸດ. - \"emblems\": ລຽງຕາມຊື່ຂອງເຄື່ອງໝາຍ (emblems) ທີ່ຕິດຢູ່ກັບລາຍການ. - \"trash-"
"time\": ລຽງຕາມເວລາທີ່ຍ້າຍໄປຖັງຂີ້ເຫຍື້ອ. - \"size_on_disk\": ລຽງຕາມພື້ນທີ່ທີ່ໃຊ້ຈິງໃນດິສກ໌. - "
"\"extension\": ລຽງຕາມນາມສະກຸນໄຟລ໌."

#: libcaja-private/org.mate.caja.gschema.xml:220
msgid "Reverse sort order in new windows"
msgstr "ລຽງລຳດັບແບບຍ້ອນກັບໃນໜ້າຕ່າງໃໝ່"

#: libcaja-private/org.mate.caja.gschema.xml:221
msgid ""
"If true, files in new windows will be sorted in reverse order. ie, if sorted "
"by name, then instead of sorting the files from \"a\" to \"z\", they will be "
"sorted from \"z\" to \"a\"; if sorted by size, instead of being "
"incrementally they will be sorted decrementally."
msgstr ""
"ຖ້າເປັນ true, ໄຟລ໌ໃນໜ້າຕ່າງໃໝ່ຈະຖືກລຽງແບບຍ້ອນກັບ. ເຊັ່ນ: ຖ້າລຽງຕາມຊື່ ກໍຈະລຽງຈາກ \"z\" ໄປຫາ "
"\"a\"; ຖ້າລຽງຕາມຂະໜາດ ກໍຈະລຽງຈາກໃຫຍ່ໄປຫານ້ອຍ."

#: libcaja-private/org.mate.caja.gschema.xml:225
msgid "Caja uses the users home folder as the desktop"
msgstr "ໃຫ້ Caja ໃຊ້ໂຟນເດີເຮືອນ (home folder) ຂອງຜູ້ໃຊ້ເປັນເດັສທັອບ"

#: libcaja-private/org.mate.caja.gschema.xml:226
msgid ""
"If set to true, then Caja will use the user's home folder as the desktop. If "
"it is false, then it will use ~/Desktop as the desktop."
msgstr ""
"ຖ້າຕັ້ງເປັນ true, Caja ຈະໃຊ້ໂຟນເດີເຮືອນຂອງຜູ້ໃຊ້ເປັນເດັສທັອບ. ຖ້າເປັນ false ຈະໃຊ້ ~/Desktop ເ"
"ປັນເດັສທັອບ."

#: libcaja-private/org.mate.caja.gschema.xml:230
msgid "Custom Background"
msgstr "ພື້ນຫຼັງທີ່ກຳນົດເອງ"

#: libcaja-private/org.mate.caja.gschema.xml:231
msgid "Whether a custom default folder background has been set."
msgstr "ກຳນົດວ່າໄດ້ມີການຕັ້ງຄ່າພື້ນຫຼັງໂຟນເດີເລີ່ມຕົ້ນແບບກຳນົດເອງໄວ້ບໍ່."

#: libcaja-private/org.mate.caja.gschema.xml:235
msgid "Default Background Color"
msgstr "ສີພື້ນຫຼັງເລີ່ມຕົ້ນ"

#: libcaja-private/org.mate.caja.gschema.xml:236
msgid ""
"Color for the default folder background. Only used if background_set is true."
msgstr ""
"ສີສຳລັບພື້ນຫຼັງໂຟນເດີເລີ່ມຕົ້ນ. ຈະຖືກໃຊ້ກໍຕໍ່ເມື່ອ background_set ເປັນ true."

#: libcaja-private/org.mate.caja.gschema.xml:240
msgid "Default Background Filename"
msgstr "ຊື່ໄຟລ໌ພື້ນຫຼັງເລີ່ມຕົ້ນ"

#: libcaja-private/org.mate.caja.gschema.xml:241
msgid ""
"Uri of the default folder background. Only used if background_set is true."
msgstr ""
"Uri ຂອງພື້ນຫຼັງໂຟນເດີເລີ່ມຕົ້ນ. ຈະຖືກໃຊ້ກໍຕໍ່ເມື່ອ background_set ເປັນ true."

#: libcaja-private/org.mate.caja.gschema.xml:245
msgid "Custom Side Pane Background Set"
msgstr "ຕັ້ງຄ່າພື້ນຫຼັງແຖບຂ້າງແບບກຳນົດເອງ"

#: libcaja-private/org.mate.caja.gschema.xml:246
msgid "Whether a custom default side pane background has been set."
msgstr "ກຳນົດວ່າໄດ້ມີການຕັ້ງຄ່າພື້ນຫຼັງແຖບຂ້າງເລີ່ມຕົ້ນແບບກຳນົດເອງໄວ້ບໍ່."

#: libcaja-private/org.mate.caja.gschema.xml:250
msgid "Default Side Pane Background Color"
msgstr "ສີພື້ນຫຼັງແຖບຂ້າງເລີ່ມຕົ້ນ"

#: libcaja-private/org.mate.caja.gschema.xml:251
msgid ""
"Filename for the default side pane background. Only used if "
"side_pane_background_set is true."
msgstr ""
"ຊື່ໄຟລ໌ສຳລັບພື້ນຫຼັງແຖບຂ້າງເລີ່ມຕົ້ນ. ຈະຖືກໃຊ້ກໍຕໍ່ເມື່ອ side_pane_background_set ເປັນ true."

#: libcaja-private/org.mate.caja.gschema.xml:255
msgid "Default Side Pane Background Filename"
msgstr "ຊື່ໄຟລ໌ພື້ນຫຼັງແຖບຂ້າງເລີ່ມຕົ້ນ"

#: libcaja-private/org.mate.caja.gschema.xml:256
msgid ""
"Uri of the default side pane background. Only used if "
"side_pane_background_set is true."
msgstr ""
"Uri ຂອງພື້ນຫຼັງແຖບຂ້າງເລີ່ມຕົ້ນ. ຈະຖືກໃຊ້ກໍຕໍ່ເມື່ອ side_pane_background_set ເປັນ true."

#: libcaja-private/org.mate.caja.gschema.xml:265
msgid "Default folder viewer"
msgstr "ຕົວສະແດງໂຟນເດີເລີ່ມຕົ້ນ"

#: libcaja-private/org.mate.caja.gschema.xml:266
msgid ""
"When a folder is visited this viewer is used unless you have selected "
"another view for that particular folder. Possible values are \"list-view\", "
"\"icon-view\" and \"compact-view\"."
msgstr ""
"ເມື່ອເຂົ້າເບິ່ງໂຟນເດີ ຈະໃຊ້ຕົວສະແດງນີ້ ຍົກເວັ້ນເຈົ້າຈະເລືອກມຸມມອງອື່ນສຳລັບໂຟນເດີນັ້ນໂດຍສະເພາະ. ຄ່າທີ່ເປັນ"
"ໄປໄດ້ຄື \"list-view\" (ລາຍການ), \"icon-view\" (ໄອຄອນ) ແລະ \"compact-view\" (ກະທັ"
"ດຮັດ)."

#: libcaja-private/org.mate.caja.gschema.xml:270
msgid "Date Format"
msgstr "ຮູບແບບວັນທີ"

#: libcaja-private/org.mate.caja.gschema.xml:271
msgid ""
"The format of file dates. Possible values are \"locale\", \"iso\", and "
"\"informal\"."
msgstr ""
"ຮູບແບບວັນທີຂອງໄຟລ໌. ຄ່າທີ່ເປັນໄປໄດ້ຄື \"locale\", \"iso\" ແລະ \"informal\"."

#: libcaja-private/org.mate.caja.gschema.xml:275
msgid "Whether to show hidden files"
msgstr "ຈະໃຫ້ສະແດງໄຟລ໌ທີ່ຊ່ອນໄວ້ບໍ່"

#: libcaja-private/org.mate.caja.gschema.xml:276
msgid ""
"If set to true, then hidden files are shown by default in the file manager. "
"Hidden files are either dotfiles or listed in the folder's .hidden file."
msgstr ""
"ຖ້າຕັ້ງເປັນ true, ໄຟລ໌ທີ່ຊ່ອນໄວ້ຈະຖືກສະແດງເປັນຄ່າເລີ່ມຕົ້ນ. ໄຟລ໌ທີ່ຊ່ອນໄວ້ແມ່ນໄຟລ໌ທີ່ມີຈຸດ (.) ທາງໜ້າ ຫຼື ໄ"
"ຟລ໌ທີ່ມີລາຍຊື່ຢູ່ໃນໄຟລ໌ .hidden."

#: libcaja-private/org.mate.caja.gschema.xml:280
msgid "Whether to show backup files"
msgstr "ຈະໃຫ້ສະແດງໄຟລ໌ສຳຮອງບໍ່"

#: libcaja-private/org.mate.caja.gschema.xml:281
msgid ""
"If set to true, then backup files are shown by default in the file manager. "
"Backup files are backup files ending with a tilde (~)."
msgstr ""
"ຖ້າຕັ້ງເປັນ true, ໄຟລ໌ສຳຮອງຈະຖືກສະແດງເປັນຄ່າເລີ່ມຕົ້ນ. ໄຟລ໌ສຳຮອງແມ່ນໄຟລ໌ທີ່ລົງທ້າຍດ້ວຍເຄື່ອງໝາຍ (~)"
"."

#: libcaja-private/org.mate.caja.gschema.xml:286
msgid "Whether to show file sizes with IEC units"
msgstr "ຈະໃຫ້ສະແດງຂະໜາດໄຟລ໌ດ້ວຍຫົວໜ່ວຍ IEC ບໍ່"

#: libcaja-private/org.mate.caja.gschema.xml:287
msgid ""
"If set to true, file sizes are shown using IEC (base 1024) units with "
"\"KiB\" style suffixes, instead of default with SI units."
msgstr ""
"ຖ້າຕັ້ງເປັນ true, ຂະໜາດໄຟລ໌ຈະສະແດງໂດຍໃຊ້ຫົວໜ່ວຍ IEC (ຖານ 1024) ເຊັ່ນ \"KiB\" ແທນທີ່ຈະໃຊ້ຫົວ"
"ໜ່ວຍ SI ປົກກະຕິ."

#: libcaja-private/org.mate.caja.gschema.xml:291
msgid "Whether to show icons in list view"
msgstr "ຈະໃຫ້ສະແດງໄອຄອນໃນມຸມມອງລາຍການບໍ່"

#: libcaja-private/org.mate.caja.gschema.xml:292
msgid "If set to true, show file icons in list view."
msgstr "ຖ້າຕັ້ງເປັນ true, ຈະສະແດງໄອຄອນໄຟລ໌ໃນມຸມມອງລາຍການ."

#: libcaja-private/org.mate.caja.gschema.xml:296
msgid "Whether to show desktop notifications"
msgstr "ຈະໃຫ້ສະແດງການແຈ້ງເຕືອນເທິງເດັສທັອບບໍ່"

#: libcaja-private/org.mate.caja.gschema.xml:297
msgid "If set to true, Caja will show desktop notifications."
msgstr "ຖ້າຕັ້ງເປັນ true, Caja ຈະສະແດງການແຈ້ງເຕືອນເທິງເດັສທັອບ."

#: libcaja-private/org.mate.caja.gschema.xml:304
msgid "List of possible captions on icons"
msgstr "ລາຍການຄຳອະທິບາຍທີ່ເປັນໄປໄດ້ເທິງໄອຄອນ"

#: libcaja-private/org.mate.caja.gschema.xml:305
msgid ""
"A list of captions below an icon in the icon view and the desktop. The "
"actual number of captions shown depends on the zoom level. Some possible "
"values are: \"size\", \"type\", \"date_modified\", \"date_created\", "
"\"date_changed\", \"date_accessed\", \"owner\", \"group\", \"permissions\", "
"\"octal_permissions\" and \"mime_type\"."
msgstr ""
"ລາຍການຄຳອະທິບາຍກ້ອງໄອຄອນ. ຈຳນວນທີ່ສະແດງຈະຂຶ້ນກັບລະດັບການຊູມ. ຄ່າທີ່ເປັນໄປໄດ້ຄື: \"size\" (ຂະ"
"ໜາດ), \"type\" (ປະເພດ), \"date_modified\" (ວັນທີແກ້ໄຂ) ແລະ ອື່ນໆ."

#: libcaja-private/org.mate.caja.gschema.xml:313
msgid "Use tighter layout in new windows"
msgstr "ໃຊ້ການຈັດວາງແບບເບຽດກັນຫຼາຍຂຶ້ນໃນໜ້າຕ່າງໃໝ່"

#: libcaja-private/org.mate.caja.gschema.xml:314
msgid "If true, icons will be laid out tighter by default in new windows."
msgstr ""
"ຖ້າເປັນ true, ໄອຄອນຈະຖືກຈັດວາງໃຫ້ໃກ້ກັນຫຼາຍຂຶ້ນເປັນຄ່າເລີ່ມຕົ້ນໃນໜ້າຕ່າງໃໝ່."

#: libcaja-private/org.mate.caja.gschema.xml:318
msgid "Put labels beside icons"
msgstr "ວາງປ້າຍຊື່ໄວ້ຂ້າງໄອຄອນ"

#: libcaja-private/org.mate.caja.gschema.xml:319
msgid ""
"If true, labels will be placed beside icons rather than underneath them."
msgstr "ຖ້າເປັນ true, ປ້າຍຊື່ຈະຖືກວາງໄວ້ທາງຂ້າງໄອຄອນ ແທນທີ່ຈະຢູ່ທາງກ້ອງ."

#: libcaja-private/org.mate.caja.gschema.xml:323
msgid "Display the git branch with directory name"
msgstr "ສະແດງ git branch ພ້ອມກັບຊື່ໄດເຣັກທໍຣີ"

#: libcaja-private/org.mate.caja.gschema.xml:324
msgid "If true, git branch name will be displayed."
msgstr "ຖ້າເປັນ true, ຈະສະແດງຊື່ git branch."

#: libcaja-private/org.mate.caja.gschema.xml:328
msgid "Default icon zoom level"
msgstr "ລະດັບການຊູມໄອຄອນເລີ່ມຕົ້ນ"

#: libcaja-private/org.mate.caja.gschema.xml:329
msgid "Default zoom level used by the icon view."
msgstr "ລະດັບການຊູມເລີ່ມຕົ້ນທີ່ໃຊ້ໃນມຸມມອງໄອຄອນ."

#: libcaja-private/org.mate.caja.gschema.xml:333
msgid "Default Thumbnail Icon Size"
msgstr "ຂະໜາດໄອຄອນຮູບຕົວຢ່າງເລີ່ມຕົ້ນ"

#: libcaja-private/org.mate.caja.gschema.xml:334
msgid "The default size of an icon for a thumbnail in the icon view."
msgstr "ຂະໜາດເລີ່ມຕົ້ນຂອງໄອຄອນສຳລັບຮູບຕົວຢ່າງໃນມຸມມອງໄອຄອນ."

#: libcaja-private/org.mate.caja.gschema.xml:338
#: libcaja-private/org.mate.caja.gschema.xml:457
msgid "Text Ellipsis Limit"
msgstr "ຂີດຈຳກັດການຫຍໍ້ຂໍ້ຄວາມດ້ວຍຈຸດສາມຈຸດ"

#: libcaja-private/org.mate.caja.gschema.xml:339
msgid ""
"A string specifying how parts of overlong file names should be replaced by "
"ellipses, depending on the zoom level. Each of the list entries is of the "
"form \"Zoom Level:Integer\". For each specified zoom level, if the given "
"integer is larger than 0, the file name will not exceed the given number of "
"lines. If the integer is 0 or smaller, no limit is imposed on the specified "
"zoom level. A default entry of the form \"Integer\" without any specified "
"zoom level is also allowed. It defines the maximum number of lines for all "
"other zoom levels. Examples: 0 - always display overlong file names; 3 - "
"shorten file names if they exceed three lines; smallest:5,smaller:4,0 - "
"shorten file names if they exceed five lines for zoom level \"smallest\". "
"Shorten file names if they exceed four lines for zoom level \"smaller\". Do "
"not shorten file names for other zoom levels. Available zoom levels: "
"smallest (33%), smaller (50%), small (66%), standard (100%), large (150%), "
"larger (200%), largest (400%)"
msgstr ""
"ກຳນົດການຫຍໍ້ຊື່ໄຟລ໌ທີ່ຍາວເກີນໄປດ້ວຍຈຸດສາມຈຸດ (...) ຕາມລະດັບການຊູມ. ຮູບແບບຄື \"Zoom "
"Level:Integer\". ຕົວຢ່າງ: 0 - ສະແດງຊື່ເຕັມສະເໝີ; 3 - ຫຍໍ້ຊື່ໄຟລ໌ຖ້າມັນຍາວເກີນ 3 ແຖວ."

#: libcaja-private/org.mate.caja.gschema.xml:364
msgid "Default compact view zoom level"
msgstr "ລະດັບການຊູມມຸມມອງກະທັດຮັດເລີ່ມຕົ້ນ"

#: libcaja-private/org.mate.caja.gschema.xml:365
msgid "Default zoom level used by the compact view."
msgstr "ລະດັບການຊູມເລີ່ມຕົ້ນທີ່ໃຊ້ໃນມຸມມອງແບບກະທັດຮັດ."

#: libcaja-private/org.mate.caja.gschema.xml:369
msgid "All columns have same width"
msgstr "ທຸກຄໍລຳໃຫ້ມີຄວາມກວ້າງເທົ່າກັນ"

#: libcaja-private/org.mate.caja.gschema.xml:370
msgid ""
"If this preference is set, all columns in the compact view have the same "
"width. Otherwise, the width of each column is determined seperately."
msgstr ""
"ຖ້າເລືອກຄ່ານີ້, ທຸກຄໍລຳໃນມຸມມອງແບບກະທັດຮັດຈະມີຄວາມກວ້າງເທົ່າກັນ. ຖ້າບໍ່ດັ່ງນັ້ນ, ຄວາມກວ້າງຂອງແຕ່ລະຄໍລຳ"
"ຈະຖືກກຳນົດແຍກກັນ."

#: libcaja-private/org.mate.caja.gschema.xml:377
msgid "Default list zoom level"
msgstr "ລະດັບການຊູມມຸມມອງລາຍການເລີ່ມຕົ້ນ"

#: libcaja-private/org.mate.caja.gschema.xml:378
msgid "Default zoom level used by the list view."
msgstr "ລະດັບການຊູມເລີ່ມຕົ້ນທີ່ໃຊ້ໃນມຸມມອງລາຍການ."

#: libcaja-private/org.mate.caja.gschema.xml:382
msgid "Default list of columns visible in the list view"
msgstr "ລາຍການຄໍລຳເລີ່ມຕົ້ນທີ່ຈະໃຫ້ເຫັນໃນມຸມມອງລາຍການ"

#: libcaja-private/org.mate.caja.gschema.xml:383
msgid "Default list of columns visible in the list view."
msgstr "ລາຍການຄໍລຳເລີ່ມຕົ້ນທີ່ຈະໃຫ້ສະແດງໃນມຸມມອງລາຍການ."

#: libcaja-private/org.mate.caja.gschema.xml:387
msgid "Default column order in the list view"
msgstr "ລຳດັບຄໍລຳເລີ່ມຕົ້ນໃນມຸມມອງລາຍການ"

#: libcaja-private/org.mate.caja.gschema.xml:388
msgid "Default column order in the list view."
msgstr "ລຳດັບຄໍລຳເລີ່ມຕົ້ນໃນມຸມມອງລາຍການ."

#: libcaja-private/org.mate.caja.gschema.xml:399
msgid "Only show folders in the tree side pane"
msgstr "ສະແດງສະເພາະໂຟນເດີໃນແຖບຂ້າງແບບຕົ້ນໄມ້"

#: libcaja-private/org.mate.caja.gschema.xml:400
msgid ""
"If set to true, Caja will only show folders in the tree side pane. Otherwise "
"it will show both folders and files."
msgstr ""
"ຖ້າຕັ້ງເປັນ true, Caja ຈະສະແດງສະເພາະໂຟນເດີໃນແຖບຂ້າງແບບຕົ້ນໄມ້. ຖ້າບໍ່ດັ່ງນັ້ນ ມັນຈະສະແດງທັງໂຟນເ"
"ດີ ແລະ ໄຟລ໌."

#: libcaja-private/org.mate.caja.gschema.xml:407
msgid "Desktop font"
msgstr "ຟອນທ໌ຂອງເດັສທັອບ"

#: libcaja-private/org.mate.caja.gschema.xml:408
msgid "The font description used for the icons on the desktop."
msgstr "ລາຍລະອຽດຟອນທ໌ທີ່ໃຊ້ສຳລັບໄອຄອນເທິງເດັສທັອບ."

#: libcaja-private/org.mate.caja.gschema.xml:412
msgid "Home icon visible on desktop"
msgstr "ສະແດງໄອຄອນ \"ບ້ານ\" ເທິງເດັສທັອບ"

#: libcaja-private/org.mate.caja.gschema.xml:413
msgid ""
"If this is set to true, an icon linking to the home folder will be put on "
"the desktop."
msgstr "ຖ້າຕັ້ງເປັນ true, ໄອຄອນທີ່ເຊື່ອມຫາໂຟນເດີເຮືອນຈະຖືກວາງໄວ້ເທິງເດັສທັອບ."

#: libcaja-private/org.mate.caja.gschema.xml:417
msgid "Computer icon visible on desktop"
msgstr "ສະແດງໄອຄອນ \"ຄອມພິວເຕີ\" ເທິງເດັສທັອບ"

#: libcaja-private/org.mate.caja.gschema.xml:418
msgid ""
"If this is set to true, an icon linking to the computer location will be put "
"on the desktop."
msgstr ""
"ຖ້າຕັ້ງເປັນ true, ໄອຄອນທີ່ເຊື່ອມຫາຕຳແໜ່ງຄອມພິວເຕີຈະຖືກວາງໄວ້ເທິງເດັສທັອບ."

#: libcaja-private/org.mate.caja.gschema.xml:422
msgid "Trash icon visible on desktop"
msgstr "ສະແດງໄອຄອນ \"ຖັງຂີ້ເຫຍື້ອ\" ເທິງເດັສທັອບ"

#: libcaja-private/org.mate.caja.gschema.xml:423
msgid ""
"If this is set to true, an icon linking to the trash will be put on the "
"desktop."
msgstr "ຖ້າຕັ້ງເປັນ true, ໄອຄອນທີ່ເຊື່ອມຫາຖັງຂີ້ເຫຍື້ອຈະຖືກວາງໄວ້ເທິງເດັສທັອບ."

#: libcaja-private/org.mate.caja.gschema.xml:427
msgid "Show mounted volumes on the desktop"
msgstr "ສະແດງໂວລຸມທີ່ຕິດຕັ້ງໄວ້ເທິງເດັສທັອບ"

#: libcaja-private/org.mate.caja.gschema.xml:428
msgid ""
"If this is set to true, icons linking to mounted volumes will be put on the "
"desktop."
msgstr ""
"ຖ້າຕັ້ງເປັນ true, ໄອຄອນທີ່ເຊື່ອມຫາໂວລຸມທີ່ຕິດຕັ້ງໄວ້ (ເຊັ່ນ USB) ຈະຖືກວາງໄວ້ເທິງເດັສທັອບ."

#: libcaja-private/org.mate.caja.gschema.xml:432
msgid "Network Servers icon visible on the desktop"
msgstr "ສະແດງໄອຄອນ \"ເຊີເວີເຄືອຂ່າຍ\" ເທິງເດັສທັອບ"

#: libcaja-private/org.mate.caja.gschema.xml:433
msgid ""
"If this is set to true, an icon linking to the Network Servers view will be "
"put on the desktop."
msgstr ""
"ຖ້າຕັ້ງເປັນ true, ໄອຄອນທີ່ເຊື່ອມຫາເຊີເວີເຄືອຂ່າຍຈະຖືກວາງໄວ້ເທິງເດັສທັອບ."

#: libcaja-private/org.mate.caja.gschema.xml:437
msgid "Desktop computer icon name"
msgstr "ຊື່ຂອງໄອຄອນຄອມພິວເຕີເທິງເດັສທັອບ"

#: libcaja-private/org.mate.caja.gschema.xml:438
msgid ""
"This name can be set if you want a custom name for the computer icon on the "
"desktop."
msgstr ""
"ສາມາດຕັ້ງຊື່ນີ້ໄດ້ ຖ້າເຈົ້າຕ້ອງການຊື່ສະເພາະສຳລັບໄອຄອນຄອມພິວເຕີເທິງເດັສທັອບ."

#: libcaja-private/org.mate.caja.gschema.xml:442
msgid "Desktop home icon name"
msgstr "ຊື່ຂອງໄອຄອນເຮືອນເທິງເດັສທັອບ"

#: libcaja-private/org.mate.caja.gschema.xml:443
msgid ""
"This name can be set if you want a custom name for the home icon on the "
"desktop."
msgstr "ສາມາດຕັ້ງຊື່ນີ້ໄດ້ ຖ້າເຈົ້າຕ້ອງການຊື່ສະເພາະສຳລັບໄອຄອນເຮືອນເທິງເດັສທັອບ."

#: libcaja-private/org.mate.caja.gschema.xml:447
msgid "Desktop trash icon name"
msgstr "ຊື່ໄອຄອນຖັງຂີ້ເຫຍື້ອເທິງໜ້າຈໍ"

#: libcaja-private/org.mate.caja.gschema.xml:448
msgid ""
"This name can be set if you want a custom name for the trash icon on the "
"desktop."
msgstr ""
"ຊື່ນີ້ສາມາດຕັ້ງຄ່າໄດ້ ຫາກທ່ານຕ້ອງການກຳນົດຊື່ໄອຄອນຖັງຂີ້ເຫຍື້ອເທິງໜ້າຈໍດ້ວຍຕົນເອງ."

#: libcaja-private/org.mate.caja.gschema.xml:452
msgid "Network servers icon name"
msgstr "ຊື່ໄອຄອນເຊີເວີເຄືອຂ່າຍ"

#: libcaja-private/org.mate.caja.gschema.xml:453
msgid ""
"This name can be set if you want a custom name for the network servers icon "
"on the desktop."
msgstr ""
"ຊື່ນີ້ສາມາດຕັ້ງຄ່າໄດ້ ຫາກທ່ານຕ້ອງການກຳນົດຊື່ໄອຄອນເຊີເວີເຄືອຂ່າຍເທິງໜ້າຈໍດ້ວຍຕົນເອງ."

#: libcaja-private/org.mate.caja.gschema.xml:458
msgid ""
"An integer specifying how parts of overlong file names should be replaced by "
"ellipses on the desktop. If the number is larger than 0, the file name will "
"not exceed the given number of lines. If the number is 0 or smaller, no "
"limit is imposed on the number of displayed lines."
msgstr ""
"ຕົວເລກຈຳນວນຖ້ວນທີ່ລະບຸວ່າ ຄວນແທນທີ່ຊື່ໄຟລ໌ທີ່ຍາວເກີນໄປດ້ວຍເຄື່ອງໝາຍຈຸດໄຂ່ປາ (...) ແນວໃດເທິງໜ້າຈໍ. ຫ"
"າກຕົວເລກຫຼາຍກວ່າ 0, ຊື່ໄຟລ໌ຈະສະແດງບໍ່ເກີນຈຳນວນແຖວທີ່ກຳນົດ. ຫາກຕົວເລກແມ່ນ 0 ຫຼື ໜ້ອຍກວ່າ, ຈະບໍ່ມີກາ"
"ນຈຳກັດຈຳນວນແຖວທີ່ສະແດງ."

#: libcaja-private/org.mate.caja.gschema.xml:465
msgid "The geometry string for a navigation window."
msgstr "ຂໍ້ຄວາມກຳນົດຂະໜາດ ແລະ ຕຳແໜ່ງ (geometry) ສຳລັບປ່ອງຢ້ຽມນຳທາງ."

#: libcaja-private/org.mate.caja.gschema.xml:466
msgid ""
"A string containing the saved geometry and coordinates string for navigation "
"windows."
msgstr "ຂໍ້ຄວາມທີ່ບັນຈຸຄ່າຂະໜາດ ແລະ ພິກັດທີ່ບັນທຶກໄວ້ສຳລັບປ່ອງຢ້ຽມນຳທາງ."

#: libcaja-private/org.mate.caja.gschema.xml:470
msgid "Whether the navigation window should be maximized."
msgstr "ກຳນົດວ່າ ຄວນເປີດປ່ອງຢ້ຽມນຳທາງແບບເຕັມຈໍຫຼືບໍ່."

#: libcaja-private/org.mate.caja.gschema.xml:471
msgid "Whether the navigation window should be maximized by default."
msgstr "ກຳນົດວ່າ ຄວນໃຫ້ປ່ອງຢ້ຽມນຳທາງເປັນແບບເຕັມຈໍໂດຍຄ່າເລີ່ມຕົ້ນຫຼືບໍ່."

#: libcaja-private/org.mate.caja.gschema.xml:475
msgid "Width of the side pane"
msgstr "ຄວາມກວ້າງຂອງແຖບດ້ານຂ້າງ"

#: libcaja-private/org.mate.caja.gschema.xml:476
msgid "The default width of the side pane in new windows."
msgstr "ຄວາມກວ້າງເລີ່ມຕົ້ນຂອງແຖບດ້ານຂ້າງໃນປ່ອງຢ້ຽມໃໝ່."

#: libcaja-private/org.mate.caja.gschema.xml:480
msgid "Show toolbar in new windows"
msgstr "ສະແດງແຖບເຄື່ອງມືໃນປ່ອງຢ້ຽມໃໝ່"

#: libcaja-private/org.mate.caja.gschema.xml:481
msgid "If set to true, newly opened windows will have toolbars visible."
msgstr "ຫາກຕັ້ງເປັນຄ່າຈິງ, ປ່ອງຢ້ຽມທີ່ເປີດໃໝ່ຈະສະແດງແຖບເຄື່ອງມື."

#: libcaja-private/org.mate.caja.gschema.xml:485
msgid "Show location bar in new windows"
msgstr "ສະແດງແຖບທີ່ຢູ່ໃໝ່ໃນປ່ອງຢ້ຽມໃໝ່"

#: libcaja-private/org.mate.caja.gschema.xml:486
msgid ""
"If set to true, newly opened windows will have the location bar visible."
msgstr "ຫາກຕັ້ງເປັນຄ່າຈິງ, ປ່ອງຢ້ຽມທີ່ເປີດໃໝ່ຈະສະແດງແຖບທີ່ຢູ່."

#: libcaja-private/org.mate.caja.gschema.xml:490
msgid "Show status bar in new windows"
msgstr "ສະແດງແຖບສະຖານະໃນປ່ອງຢ້ຽມໃໝ່"

#: libcaja-private/org.mate.caja.gschema.xml:491
msgid "If set to true, newly opened windows will have the status bar visible."
msgstr "ຫາກຕັ້ງເປັນຄ່າຈິງ, ປ່ອງຢ້ຽມທີ່ເປີດໃໝ່ຈະສະແດງແຖບສະຖານະ."

#: libcaja-private/org.mate.caja.gschema.xml:495
msgid "Show side pane in new windows"
msgstr "ສະແດງແຖບດ້ານຂ້າງໃນປ່ອງຢ້ຽມໃໝ່"

#: libcaja-private/org.mate.caja.gschema.xml:496
msgid "If set to true, newly opened windows will have the side pane visible."
msgstr "ຫາກຕັ້ງເປັນຄ່າຈິງ, ປ່ອງຢ້ຽມທີ່ເປີດໃໝ່ຈະສະແດງແຖບດ້ານຂ້າງ."

#: libcaja-private/org.mate.caja.gschema.xml:518
msgid "Side pane view"
msgstr "ມຸມມອງແຖບດ້ານຂ້າງ"

#: libcaja-private/org.mate.caja.gschema.xml:519
msgid "The side pane view to show in newly opened windows."
msgstr "ຮູບແບບມຸມມອງແຖບດ້ານຂ້າງທີ່ຈະສະແດງໃນປ່ອງຢ້ຽມທີ່ເປີດໃໝ່."

#: libcaja-private/org.mate.caja.gschema.xml:526
msgid "List of extensions in disabled state."
msgstr "ລາຍຊື່ສ່ວນຂະຫຍາຍທີ່ຢູ່ໃນສະຖານະຖືກປິດໃຊ້ງານ."

#: libcaja-private/org.mate.caja.gschema.xml:527
msgid "This list contains the extensions that are currently de-activated."
msgstr "ລາຍຊື່ນີ້ບັນຈຸສ່ວນຂະຫຍາຍທີ່ຖືກປິດການໃຊ້ງານຢູ່ໃນປະຈຸບັນ."

#: libcaja-private/org.mate.media-handling.gschema.xml:5
msgid "Whether to automatically mount media"
msgstr "ກຳນົດວ່າ ຈະໃຫ້ເຊື່ອມຕໍ່ (mount) ສື່ບັນທຶກຂໍ້ມູນໂດຍອັດຕະໂນມັດຫຼືບໍ່"

#: libcaja-private/org.mate.media-handling.gschema.xml:6
msgid ""
"If set to true, then Caja will automatically mount media such as user-"
"visible hard disks and removable media on start-up and media insertion."
msgstr ""
"ຫາກຕັ້ງເປັນຄ່າຈິງ, Caja ຈະເຊື່ອມຕໍ່ສື່ບັນທຶກຂໍ້ມູນໂດຍອັດຕະໂນມັດ ເຊັ່ນ: ຮາດດິດ ແລະ ສື່ທີ່ຖອດຖອນໄດ້ ເມື່ອເລີ່"
"ມລະບົບ ຫຼື ເມື່ອສຽບສື່ເຂົ້າໄປ."

#: libcaja-private/org.mate.media-handling.gschema.xml:10
msgid "Whether to automatically open a folder for automounted media"
msgstr ""
"ກຳນົດວ່າ ຈະໃຫ້ເປີດໂຟນເດີໂດຍອັດຕະໂນມັດສຳລັບສື່ທີ່ເຊື່ອມຕໍ່ແບບອັດຕະໂນມັດຫຼືບໍ່"

#: libcaja-private/org.mate.media-handling.gschema.xml:11
msgid ""
"If set to true, then Caja will automatically open a folder when media is "
"automounted. This only applies to media where no known x-content/* type was "
"detected; for media where a known x-content type is detected, the user "
"configurable action will be taken instead."
msgstr ""
"ຫາກຕັ້ງເປັນຄ່າຈິງ, Caja ຈະເປີດໂຟນເດີໂດຍອັດຕະໂນມັດເມື່ອສື່ຖືກເຊື່ອມຕໍ່. ຄ່ານີ້ຈະໃຊ້ກັບສື່ທີ່ບໍ່ພົບປະເພດ x-"
"content/* ເທົ່ານັ້ນ; ສຳລັບສື່ທີ່ລະບຸປະເພດໄດ້, ຈະໃຊ້ການຕັ້ງຄ່າທີ່ຜູ້ໃຊ້ກຳນົດໄວ້ແທນ."

#: libcaja-private/org.mate.media-handling.gschema.xml:15
msgid "Never prompt or autorun/autostart programs when media are inserted"
msgstr "ບໍ່ຕ້ອງຖາມ ຫຼື ເປີດໂປຣແກຣມອັດຕະໂນມັດເມື່ອມີການສຽບສື່ບັນທຶກຂໍ້ມູນ"

#: libcaja-private/org.mate.media-handling.gschema.xml:16
msgid ""
"If set to true, then Caja will never prompt nor autorun/autostart programs "
"when a medium is inserted."
msgstr ""
"ຫາກຕັ້ງເປັນຄ່າຈິງ, Caja ຈະບໍ່ຖາມ ຫຼື ເປີດໂປຣແກຣມອັດຕະໂນມັດໃດໆ ເມື່ອມີການສຽບສື່ບັນທຶກຂໍ້ມູນ."

#: libcaja-private/org.mate.media-handling.gschema.xml:20
msgid ""
"List of x-content/* types where the preferred application will be launched"
msgstr "ລາຍຊື່ປະເພດ x-content/* ທີ່ຈະໃຫ້ເປີດດ້ວຍແອັບພລິເຄຊັນທີ່ເລືອກໄວ້"

#: libcaja-private/org.mate.media-handling.gschema.xml:21
msgid ""
"List of x-content/* types for which the user have chosen to start an "
"application in the preference capplet. The preferred application for the "
"given type will be started on insertion on media matching these types."
msgstr ""
"ລາຍຊື່ປະເພດ x-content/* ທີ່ຜູ້ໃຊ້ໄດ້ເລືອກໃຫ້ເປີດແອັບພລິເຄຊັນໄວ້ໃນສ່ວນການຕັ້ງຄ່າ. ແອັບພລິເຄຊັນທີ່ເລືອກຈ"
"ະຖືກເປີດທັນທີເມື່ອສຽບສື່ທີ່ກົງກັບປະເພດເຫຼົ່ານີ້."

#: libcaja-private/org.mate.media-handling.gschema.xml:25
msgid "List of x-content/* types set to \"Do Nothing\""
msgstr "ລາຍຊື່ປະເພດ x-content/* ທີ່ຕັ້ງຄ່າເປັນ \"ບໍ່ຕ້ອງເຮັດຫຍັງ\""

#: libcaja-private/org.mate.media-handling.gschema.xml:26
msgid ""
"List of x-content/* types for which the user have chosen \"Do Nothing\" in "
"the preference capplet. No prompt will be shown nor will any matching "
"application be started on insertion of media matching these types."
msgstr ""
"ລາຍຊື່ປະເພດ x-content/* ທີ່ຜູ້ໃຊ້ເລືອກ \"ບໍ່ຕ້ອງເຮັດຫຍັງ\". ຈະບໍ່ມີການຖາມ ຫຼື ເປີດແອັບພລິເຄຊັນໃດໆ ເ"
"ມື່ອສຽບສື່ປະເພດເຫຼົ່ານີ້."

#: libcaja-private/org.mate.media-handling.gschema.xml:30
msgid "List of x-content/* types set to \"Open Folder\""
msgstr "ລາຍຊື່ປະເພດ x-content/* ທີ່ຕັ້ງຄ່າເປັນ \"ເປີດໂຟນເດີ\""

#: libcaja-private/org.mate.media-handling.gschema.xml:31
msgid ""
"List of x-content/* types for which the user have chosen \"Open Folder\" in "
"the preferences capplet. A folder window will be opened on insertion of "
"media matching these types."
msgstr ""
"ລາຍຊື່ປະເພດ x-content/* ທີ່ຜູ້ໃຊ້ເລືອກ \"ເປີດໂຟນເດີ\". ປ່ອງຢ້ຽມໂຟນເດີຈະຖືກເປີດຂຶ້ນເມື່ອສຽບສື່ປະເພດ"
"ເຫຼົ່ານີ້."

#: mate-submodules/libegg/eggdesktopfile.c:169
msgid "File is not a valid .desktop file"
msgstr "ໄຟລ໌ນີ້ບໍ່ແມ່ນໄຟລ໌ .desktop ທີ່ຖືກຕ້ອງ"

#: mate-submodules/libegg/eggdesktopfile.c:194
#, c-format
msgid "Unrecognized desktop file Version '%s'"
msgstr "ບໍ່ຮູ້ຈັກເວີຊັນຂອງໄຟລ໌ເດດທັອບ '%s'"

#: mate-submodules/libegg/eggdesktopfile.c:984
#, c-format
msgid "Starting %s"
msgstr "ກຳລັງເລີ່ມ %s"

#: mate-submodules/libegg/eggdesktopfile.c:1126
msgid "Application does not accept documents on command line"
msgstr "ແອັບພລິເຄຊັນບໍ່ຮອງຮັບການເປີດເອກະສານຜ່ານຄຳສັ່ງ (command line)"

#: mate-submodules/libegg/eggdesktopfile.c:1194
#, c-format
msgid "Unrecognized launch option: %d"
msgstr "ບໍ່ຮູ້ຈັກຕົວເລືອກການເປີດ: %d"

#: mate-submodules/libegg/eggdesktopfile.c:1410
msgid "Can't pass document URIs to a 'Type=Link' desktop entry"
msgstr "ບໍ່ສາມາດສົ່ງ URI ຂອງເອກະສານໄປຫາໄຟລ໌ເດດທັອບທີ່ມີ 'Type=Link'"

#: mate-submodules/libegg/eggdesktopfile.c:1431
msgid "Not a launchable item"
msgstr "ບໍ່ແມ່ນລາຍການທີ່ສາມາດເປີດໃຊ້ງານໄດ້"

#: mate-submodules/libegg/eggsmclient.c:234
