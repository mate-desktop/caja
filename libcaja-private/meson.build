cargs = [
  '-DDATADIR="' + datadir + '"',
  '-DSYSCONFDIR="' + join_paths(prefix, get_option('sysconfdir')) + '"',
  '-DCAJA_DATADIR="' + join_paths(datadir, package_name) + '"',
  '-DCAJA_EXTENSIONDIR="' + extensiondir + '"',
]

caja_marshal = gnome.genmarshal(
  'caja-marshal',
  sources: 'caja-marshal.list',
  prefix: 'caja_marshal',
)

libcaja_private_deps = core_deps + [
  libegg_dep,
  libeel_dep,
  libcaja_extension_dep,
  libnotify_dep,
  libm_dep,
]

if have_selinux
  libcaja_private_deps += [selinux_dep]
endif

libcaja_private = static_library(
  'caja-private',
  sources: [
    'caja-autorun.c',
    'caja-autorun.h',
    'caja-bookmark.c',
    'caja-bookmark.h',
    'caja-cell-renderer-text-ellipsized.c',
    'caja-cell-renderer-text-ellipsized.h',
    'caja-clipboard-monitor.c',
    'caja-clipboard-monitor.h',
    'caja-clipboard.c',
    'caja-clipboard.h',
    'caja-column-chooser.c',
    'caja-column-chooser.h',
    'caja-column-utilities.c',
    'caja-column-utilities.h',
    'caja-customization-data.c',
    'caja-customization-data.h',
    'caja-debug-log.c',
    'caja-debug-log.h',
    'caja-default-file-icon.c',
    'caja-default-file-icon.h',
    'caja-desktop-directory-file.c',
