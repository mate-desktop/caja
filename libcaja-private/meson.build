    'caja-signaller.h',
    'caja-signaller.c',
    'caja-query.c',
    'caja-query.h',
    'caja-thumbnails.c',
    'caja-thumbnails.h',
    'caja-trash-monitor.c',
    'caja-trash-monitor.h',
    'caja-tree-view-drag-dest.c',
    'caja-tree-view-drag-dest.h',
    'caja-ui-utilities.c',
    'caja-ui-utilities.h',
    'caja-vfs-directory.c',
    'caja-vfs-directory.h',
    'caja-vfs-file.c',
    'caja-vfs-file.h',
    'caja-view-factory.c',
