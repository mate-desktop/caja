cargs = ['-DG_LOG_DOMAIN="Eel"']

eel_marshal = gnome.genmarshal(
  'eel-marshal',
  sources: 'eel-marshal.list',
  prefix: 'eel_marshal',
)

libeel_deps = core_deps + [libm_dep]

libeel = static_library(
  'eel-2',
  sources: [
    'eel-accessibility.c',
    'eel-accessibility.h',
    'eel-art-extensions.c',
    'eel-art-extensions.h',
    'eel-art-gtk-extensions.c',
    'eel-art-gtk-extensions.h',
    'eel-background.c',
    'eel-background.h',
    'eel-background-box.c',
    'eel-background-box.h',
    'eel-canvas.c',
    'eel-canvas.h',
    'eel-canvas-rect-ellipse.c',
    'eel-canvas-rect-ellipse.h',
    'eel-debug.c',
    'eel-debug.h',
    'eel-editable-label.c',
    'eel-editable-label.h',
    'eel-gdk-extensions.c',
    'eel-gdk-extensions.h',
    'eel-gdk-pixbuf-extensions.c',
    'eel-gdk-pixbuf-extensions.h',
    'eel-glib-extensions.c',
    'eel-glib-extensions.h',
    'eel-mate-extensions.c',
    'eel-mate-extensions.h',
    'eel-graphic-effects.c',
    'eel-graphic-effects.h',
    'eel-gtk-container.c',
    'eel-gtk-container.h',
    'eel-gtk-extensions.c',
    'eel-gtk-extensions.h',
    'eel-gtk-macros.h',
    'eel-image-table.c',
    'eel-image-table.h',
    'eel-labeled-image.c',
    'eel-labeled-image.h',
    'eel-lib-self-check-functions.c',
    'eel-lib-self-check-functions.h',
    'eel-self-checks.c',
    'eel-self-checks.h',
    'eel-stock-dialogs.c',
    'eel-stock-dialogs.h',
    'eel-string.c',
    'eel-string.h',
    'eel-vfs-extensions.c',
    'eel-vfs-extensions.h',
    'eel-wrap-table.c',
    'eel-wrap-table.h',
    'eel-xml-extensions.c',
    'eel-xml-extensions.h',
    'eel.h',
    eel_marshal,
  ],
  include_directories: include_directories('..'),
  dependencies: libeel_deps,
  c_args: cargs,
  install: false,
)

libeel_dep = declare_dependency(
  link_with: libeel,
  include_directories: include_directories('.'),
  dependencies: libeel_deps,
)
